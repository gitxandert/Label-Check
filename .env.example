WINDOWS_VERSION=ltsc2022
MINGW_VERSION=16.1.0
PYTHON_VERSION=3.12.10
IMAGE_TAG=latest
HOST_PORT=5000

# Credential spec must exist in Docker's CredentialSpecs directory on host.
GMSA_CREDENTIAL_SPEC=label-check.json
GMSA_HOSTNAME=label-check

# Generate long random values. Do not commit real values.
SECRET_KEY=replace-with-a-long-random-value
ADMIN_DEFAULT_PASSWORD=replace-before-first-start

# Local Windows Server directories. Network GT450 data is accessed directly by UNC.
SCANNER_INVENTORIES_HOST=D:\scanner_inventories
LABEL_CHECK_BATCHES_HOST=D:\label_check_batches
COPATH_CLONE_HOST=D:\copath_clone
LABEL_CHECK_STATE_HOST=D:\label-check-state
TQ_HOME_HOST=D:\label-check-tq
SSH_HOME_HOST=D:\label-check-ssh
